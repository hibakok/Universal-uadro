; @uadro
; @file    src/nested_calls.uasm
; @layer   L2
; @branch  t0.uasm.integration
; @desc    Программа «вложенные CALL/RET»: main вызывает sub1, та —
; @desc    sub2; подпрограммы оставляют на стеке 111 и 222, оба RET
; @desc    возвращают управление по цепочке; вывод "!", HALT 0.
; @desc    Адреса переходов — метки прохода 1 (SPEC/L2-UASM.txt,
; @desc    раздел 3), NOP-выравнивание эталона Этапа 1 не нужно;
; @desc    поведение — tests/test_uvm_integration.py,
; @desc    prog_nested_calls.

CALL sub1
PUSH '!'
SYS 1
HALT 0

sub1:
PUSH 111
CALL sub2
RET

sub2:
PUSH 222
RET
