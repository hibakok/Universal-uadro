; @uadro
; @file    src/arith.uasm
; @layer   L2
; @branch  t0.uasm.integration
; @desc    Программа «арифметика»: (2+3)*4 = 20 на стеке данных;
; @desc    константы a, b, k назначает проход 1 ассемблера
; @desc    (SPEC/L2-UASM.txt, раздел 3); образ байт в байт совпадает
; @desc    с эталоном Этапа 1 — tests/test_uvm_integration.py,
; @desc    prog_arithmetic.

a = 2
b = 3
k = 4

PUSH a
PUSH b
ADD
PUSH k
MUL
HALT 0
