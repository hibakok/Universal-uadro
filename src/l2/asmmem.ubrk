; @uadro
; @file    src/l2/asmmem.ubrk
; @layer   L2
; @branch  l2.uasm.assemble
; @desc    Ассемблер uAsm — память инструмента: use-включение главного
; @desc    файла src/l2/assemble.ubrk (SPEC/L4-SELFHOST.txt, раздел 5А).
; @desc    Раскладка ОЗУ — восемь слов-адресов четырёх буферов; кирпичи
; @desc    чтения stdin в буфер источника: keyok, roomok, storebyte.

; Раскладка ОЗУ инструмента (SPEC/L4-SELFHOST.txt, раздел 5А):
; собственный образ инструмента загружается с адреса 0 и лежит ниже
; буферов; адреса фиксированы, лимиты — часть контракта инструмента.

; @method srcbase ( -- addr )
; @in    нет
; @out   addr: слово — адрес 0x10000, первый байт буфера источника
; @does  Раскладка ОЗУ: буфер источника (текст uAsm из stdin) начинается
; @does  с адреса 0x10000 и занимает 512 КиБ.
: srcbase
  0x10000 ;

; @method srclimit ( -- addr )
; @in    нет
; @out   addr: слово — адрес 0x90000, за последним байтом буфера
; @out   источника
; @does  Раскладка ОЗУ: предел буфера источника; вход длиннее — «вход
; @does  слишком большой» и код 16 (SPEC/L4-SELFHOST.txt, раздел 5А).
: srclimit
  0x90000 ;

; @method imgbase ( -- addr )
; @in    нет
; @out   addr: слово — адрес 0x90000, первый байт буфера образа
; @does  Раскладка ОЗУ: буфер образа (собираемый образ UVM) — 64 КиБ
; @does  (SPEC/L4-SELFHOST.txt, раздел 5А).
: imgbase
  0x90000 ;

; @method imglimit ( -- addr )
; @in    нет
; @out   addr: слово — адрес 0xA0000, за последним байтом буфера образа
; @does  Раскладка ОЗУ: предел буфера образа; образ длиннее — «образ
; @does  слишком большой» и код 16 (SPEC/L4-SELFHOST.txt, раздел 5А).
: imglimit
  0xA0000 ;

; @method symbase ( -- addr )
; @in    нет
; @out   addr: слово — адрес 0xA0000, первый байт таблицы символов
; @does  Раскладка ОЗУ: таблица символов — записи «значение 8 байтов LE
; @does  + имя + байт 0», 320 КиБ (SPEC/L4-SELFHOST.txt, раздел 5А).
: symbase
  0xA0000 ;

; @method symlimit ( -- addr )
; @in    нет
; @out   addr: слово — адрес 0xF0000, за последним байтом таблицы
; @out   символов
; @does  Раскладка ОЗУ: предел таблицы символов; больше — «таблица
; @does  символов переполнена» и код 16 (SPEC/L4-SELFHOST.txt, раздел 5А).
: symlimit
  0xF0000 ;

; @method argbase ( -- addr )
; @in    нет
; @out   addr: слово — адрес 0xF0000, первый байт буфера аргументов
; @does  Раскладка ОЗУ: буфер аргументов DB/DW одной строки — пары
; @does  (адрес, длина), не более 256, 4 КиБ (SPEC/L4-SELFHOST.txt,
; @does  раздел 5А).
: argbase
  0xF0000 ;

; @method arglimit ( -- addr )
; @in    нет
; @out   addr: слово — адрес 0xF1000, за последним байтом буфера
; @out   аргументов
; @does  Раскладка ОЗУ: предел буфера аргументов; больше — «слишком
; @does  много аргументов» и код 16 (SPEC/L4-SELFHOST.txt, раздел 5А).
: arglimit
  0xF1000 ;

; @method keyok ( -- c 1 | 0 )
; @in    нет (байт входа читается из stdin, KEY)
; @out   pair: c и флаг 1 — прочитан байт; либо 0 без байта — EOF
; @does  Читает байт входа инструмента (KEY): EOF даёт только флаг 0,
; @does  байт — c и флаг 1; кирпич readstep главного файла
; @does  assemble.ubrk.
; @depends KEY
: keyok
  KEY DUP -1 EQ IF DROP 0 EXIT THEN 1 ;

; @method roomok ( cur -- flag )
; @in    cur: слово — адрес следующего байта буфера источника
; @out   flag: слово — 1: байт влезает (cur < srclimit); 0: буфер полон
; @does  Проверка ёмкости буфера источника перед записью байта: вход
; @does  сверх 512 КиБ обязан закончиться диагностикой «вход слишком
; @does  большой» и кодом 16 (SPEC/L4-SELFHOST.txt, раздел 5А).
; @depends srclimit, LTU
: roomok
  srclimit LTU ;

; @method storebyte ( cur c -- cur' )
; @in    cur: слово — адрес следующего байта буфера источника
; @in    c: слово — прочитанный байт входа 0..255
; @out   cur': слово — адрес следующего байта буфера после записи
; @does  Записывает байт c в буфер источника по адресу cur (STORE8)
; @does  и возвращает cur + 1; кирпич readstep главного файла
; @does  assemble.ubrk.
; @depends OVER, STORE8, ADD
: storebyte
  OVER STORE8 1 ADD ;
