; @uadro
; @file    src/l2/disasm.ubrk
; @layer   L2
; @branch  l2.uasm.disasm
; @desc    Дизассемблер uAsm — собственное воплощение Этапа 4: вход —
; @desc    образ UVM в stdin (KEY), выход — текст uAsm в stdout (EMIT),
; @desc    код завершения 0 (SPEC/L4-SELFHOST.txt, разделы 4-5).
; @desc    Подшаги 1-2: каркас, таблица мнемоник, поле imm64 и печать
; @desc    десятичного значения. Опкод без поля — строка «МНЕМОНИКА»;
; @desc    опкод с полем imm64 — строка «МНЕМОНИКА значение» (десятичное
; @desc    слово 0..2^64-1); неизвестный код, EOF и обрыв поля —
; @desc    останов декодирования (строка не печатается). Хвост DB —
; @desc    подшаг 3, золотая сверка с эталоном — подшаг 4.

; Таблицы мнемоник (SPEC/L4-SELFHOST.txt, раздел 5): шесть строк по
; диапазонам кодов; запись — восемь байтов: мнемоника, дополненная
; нулями; печать записи — словом prints (до нулевого байта).

; @method tstm ( -- addr )
; @in    нет
; @out   addr: слово — адрес строки таблицы мнемоник 0x00-0x07 (стек)
; @does  Данные: восемь записей по восемь байтов (NOP PUSH DROP DUP SWAP
; @does  OVER ROT PICK); запись кода c — по адресу tstm + c * 8.
text tstm "NOP\0\0\0\0\0PUSH\0\0\0\0DROP\0\0\0\0DUP\0\0\0\0\0SWAP\0\0\0\0OVER\0\0\0\0ROT\0\0\0\0\0PICK\0\0\0\0"

; @method tmem ( -- addr )
; @in    нет
; @out   addr: слово — адрес строки таблицы мнемоник 0x10-0x13 (память)
; @does  Данные: четыре записи по восемь байтов (LOAD8 LOAD64 STORE8
; @does  STORE64); запись кода c — по адресу tmem + (c - 0x10) * 8.
text tmem "LOAD8\0\0\0LOAD64\0\0STORE8\0\0STORE64\0"

; @method tari ( -- addr )
; @in    нет
; @out   addr: слово — адрес строки таблицы мнемоник 0x20-0x2C (арифметика)
; @does  Данные: тринадцать записей по восемь байтов (ADD SUB MUL UDIV
; @does  UMOD NEG SHL SHR SAR AND OR XOR INV); запись кода c — по адресу
; @does  tari + (c - 0x20) * 8.
text tari "ADD\0\0\0\0\0SUB\0\0\0\0\0MUL\0\0\0\0\0UDIV\0\0\0\0UMOD\0\0\0\0NEG\0\0\0\0\0SHL\0\0\0\0\0SHR\0\0\0\0\0SAR\0\0\0\0\0AND\0\0\0\0\0OR\0\0\0\0\0\0XOR\0\0\0\0\0INV\0\0\0\0\0"

; @method tcmp ( -- addr )
; @in    нет
; @out   addr: слово — адрес строки таблицы мнемоник 0x30-0x35 (сравнения)
; @does  Данные: шесть записей по восемь байтов (EQ NEQ LTU GTU LEU GEU);
; @does  запись кода c — по адресу tcmp + (c - 0x30) * 8.
text tcmp "EQ\0\0\0\0\0\0NEQ\0\0\0\0\0LTU\0\0\0\0\0GTU\0\0\0\0\0LEU\0\0\0\0\0GEU\0\0\0\0\0"

; @method tjmp ( -- addr )
; @in    нет
; @out   addr: слово — адрес строки таблицы мнемоник 0x40-0x45 (переходы)
; @does  Данные: шесть записей по восемь байтов (JMP JZ JNZ CALL RET
; @does  HALT); запись кода c — по адресу tjmp + (c - 0x40) * 8.
text tjmp "JMP\0\0\0\0\0JZ\0\0\0\0\0\0JNZ\0\0\0\0\0CALL\0\0\0\0RET\0\0\0\0\0HALT\0\0\0\0"

; @method tsys ( -- addr )
; @in    нет
; @out   addr: слово — адрес строки таблицы мнемоник 0x50 (система)
; @does  Данные: одна запись — восемь байтов (SYS); запись кода 0x50 —
; @does  по адресу tsys.
text tsys "SYS\0\0\0\0\0"

; Ячейки поля imm64: iv — накопленное значение поля, ip — текущая
; степень 256 (1, 256, 256^2, ...), ii — число прочитанных байтов
; поля 0..8 (SPEC/L4-SELFHOST.txt, раздел 5, потоковая модель).
var iv
var ip
var ii

; @method scale8 ( idx base -- addr )
; @in    idx: слово — номер записи в строке таблицы (код - низ диапазона)
; @in    base: слово — адрес первой записи строки таблицы мнемоник
; @out   addr: слово — адрес записи idx: base + idx * 8
; @does  Адрес записи таблицы мнемоник (SPEC/L4-SELFHOST.txt, раздел 5);
; @does  кирпич слова rowbase.
; @depends SWAP, MUL, ADD
: scale8
  SWAP 8 MUL ADD ;

; @method rowbase ( code -- addr 1 | 0 )
; @in    code: слово — опкод 0..255
; @out   addr: слово — адрес записи мнемоники (при флаге 1) либо 0
; @out   flag: слово — 1: код в таблице; 0: код в дыре или за таблицей
; @does  Ищет опкод в шести строках таблицы: диапазоны 0x00-0x07 (tstm),
; @does  0x10-0x13 (tmem), 0x20-0x2C (tari), 0x30-0x35 (tcmp), 0x40-0x45
; @does  (tjmp), 0x50 (tsys); адрес записи = база строки + (код - низ) * 8
; @does  (SPEC/L4-SELFHOST.txt, раздел 5).
; @depends LEU, LTU, GTU, scale8, tstm, tmem, tari, tcmp, tjmp, tsys
: rowbase
  DUP 0x07 LEU IF tstm scale8 1 EXIT THEN
  DUP 0x10 LTU IF DROP 0 EXIT THEN
  DUP 0x13 LEU IF 0x10 SUB tmem scale8 1 EXIT THEN
  DUP 0x20 LTU IF DROP 0 EXIT THEN
  DUP 0x2C LEU IF 0x20 SUB tari scale8 1 EXIT THEN
  DUP 0x30 LTU IF DROP 0 EXIT THEN
  DUP 0x35 LEU IF 0x30 SUB tcmp scale8 1 EXIT THEN
  DUP 0x40 LTU IF DROP 0 EXIT THEN
  DUP 0x45 LEU IF 0x40 SUB tjmp scale8 1 EXIT THEN
  DUP 0x50 LTU IF DROP 0 EXIT THEN
  DUP 0x50 GTU IF DROP 0 EXIT THEN
  DROP tsys 1 ;

; @method hasimm ( code -- flag )
; @in    code: слово — опкод 0..255
; @out   flag: слово — 1, если за опкодом следует поле imm64, иначе 0
; @does  Признак поля imm64 без таблицы (SPEC/L4-SELFHOST.txt, раздел 5):
; @does  сравнения и диапазоны — коды 0x01, 0x07, 0x40-0x43, 0x45, 0x50.
; @depends EQ, LTU, LEU
: hasimm
  DUP 0x01 EQ IF DROP 1 EXIT THEN
  DUP 0x07 EQ IF DROP 1 EXIT THEN
  DUP 0x40 LTU IF DROP 0 EXIT THEN
  DUP 0x43 LEU IF DROP 1 EXIT THEN
  DUP 0x45 EQ IF DROP 1 EXIT THEN
  DUP 0x50 EQ IF DROP 1 EXIT THEN
  DROP 0 ;

; @method keyok ( -- c 1 | 0 )
; @in    нет (байт входа читается из stdin, KEY)
; @out   pair: c и флаг 1 — прочитан байт; либо 0 без байта — EOF
; @does  Читает байт входа (KEY): EOF даёт только флаг 0, байт — c
; @does  и флаг 1; кирпичи чтения поля imm64 (immstep) и цикла main.
; @depends KEY
: keyok
  KEY DUP -1 EQ IF DROP 0 EXIT THEN 1 ;

; @method accbyte ( c -- )
; @in    c: слово — прочитанный байт поля imm64 (0..255)
; @out   нет; iv получает c * ip, ip — следующую степень 256
; @does  Накапливает байт little-endian поля imm64: iv = iv + c * ip,
; @does  ip = ip * 256 (SPEC/L4-SELFHOST.txt, раздел 5); кирпич immstep.
; @depends MUL, ADD, ip, iv
: accbyte
  ip LOAD64 MUL
  iv LOAD64 ADD
  iv STORE64
  ip LOAD64 256 MUL ip STORE64 ;

; @method immstep ( -- done )
; @in    нет (ячейки iv/ip/ii — состояние поля, см. карточки var)
; @out   done: слово — 0: байт поля прочитан и накоплен; 1: поле
; @out   прочитано целиком (ii = 8) либо вход кончился (EOF)
; @does  Один шаг чтения поля imm64: восемь байтов уже прочитаны — флаг 1;
; @does  иначе keyok: байт — accbyte и ii + 1, флаг 0; EOF — флаг 1.
; @depends keyok, accbyte, ii
: immstep
  ii LOAD64 8 GEU IF 1 EXIT THEN
  keyok IF accbyte ii LOAD64 1 ADD ii STORE64 0 ELSE 1 THEN ;

; @method getimm ( -- )
; @in    нет (байты поля читаются из stdin, KEY)
; @out   нет; iv — значение поля (при ii = 8), ii — число прочитанных
; @out   байтов поля 0..8, ip — степень 256 за последним байтом
; @does  Читает поле imm64 (SPEC/L4-SELFHOST.txt, раздел 5): обнуляет
; @does  iv, ставит ip = 1 и ii = 0, затем immstep до флага готовности;
; @does  обрыв поля (ii < 8 после цикла) распознаёт вызывающий.
; @depends iv, ip, ii, immstep
: getimm
  0 iv STORE64 1 ip STORE64 0 ii STORE64
  BEGIN immstep UNTIL ;

; @method printu ( u -- )
; @in    u: слово — значение 0..2^64-1
; @out   нет (цифры выводятся в stdout, EMIT)
; @does  Печатает десятичное число (SPEC/L4-SELFHOST.txt, раздел 5):
; @does  старшие разряды — рекурсивный вызов с частным от UDIV 10,
; @does  затем младший разряд — остаток UMOD 10 + '0'; u = 0 даёт «0».
; @depends UDIV, UMOD, ADD, EMIT, printu
: printu
  DUP 10 UDIV SWAP 10 UMOD
  SWAP DUP IF printu ELSE DROP THEN
  48 ADD EMIT ;

; @method main ( -- )
; @in    нет (вход инструмента — байты stdin, KEY)
; @out   нет (выход инструмента — байты stdout, EMIT; код завершения 0)
; @does  Цикл дизассемблера: читает байт опкода (KEY); EOF — завершение
; @does  (BYE). Опкод с полем imm64 (hasimm): getimm читает поле; обрыв
; @does  поля (ii < 8) — останов, строка не печатается (хвост DB —
; @does  подшаг 3); полное поле — строка «МНЕМОНИКА значение»: prints,
; @does  space и десятичное значение iv — printu. Опкод без поля —
; @does  строка «МНЕМОНИКА» (rowbase, prints). Неизвестный код —
; @does  останов декодирования. Флаги IF снимаются с DS, поэтому ветки
; @does  после BYE стек не чистят.
; @depends KEY, BYE, rowbase, hasimm, getimm, ii, iv, prints, space, cr, printu
: main
  BEGIN
  KEY DUP -1 EQ IF DROP BYE THEN
  DUP hasimm
  IF
    getimm
    ii LOAD64 8 LTU IF BYE THEN
    rowbase IF prints space iv LOAD64 printu ELSE BYE THEN
  ELSE
    rowbase IF prints ELSE BYE THEN
  THEN
  cr
  AGAIN ;
