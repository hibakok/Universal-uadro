; @uadro
; @file    src/l2/assemble.ubrk
; @layer   L2
; @branch  l2.uasm.assemble
; @desc    Ассемблер uAsm — собственное воплощение Этапа 4: вход — текст
; @desc    uAsm в stdin (KEY), выход — образ UVM в stdout (EMIT); код 0 —
; @desc    успех, 16 — ошибка входа (SPEC/L4-SELFHOST.txt, разделы 4 и 5А).
; @desc    Подшаг 1 (каркас и память): use-включение asmmem.ubrk — вход
; @desc    читается целиком в буфер источника 512 КиБ (readstep), вход
; @desc    сверх лимита — строка «вход слишком большой» и код 16. Подшаг 2
; @desc    (строки и слова): use-включения asmwords.ubrk (деление буфера
; @desc    на строки, чистка строки, первое слово, аргументы парами)
; @desc    и asmmnem.ubrk (таблица мнемоник и поиск кода). Подшаг 3
; @desc    (литералы и имена): use-включение asmlex.ubrk — числовые формы,
; @desc    минус, диапазон, имена и скан строковых литералов DS/DZ;
; @desc    листинг «N:слово[=код] …» теперь с лексическими пометами
; @desc    аргументов (lexlist) и сканом литерала DS/DZ (dsline) —
; @desc    промежуточное поведение, заменяемое разбором записей в подшаге
; @desc    4. Записи, символы и проходы — подшаги 4-7 (SPEC/
; @desc    L4-SELFHOST.txt, раздел 5А).
use asmmem.ubrk
use asmwords.ubrk
use asmmnem.ubrk
use asmlex.ubrk

; @method tbig ( -- addr )
; @in    нет
; @out   addr: слово — адрес строки «вход слишком большой» (UTF-8 + 0)
; @does  Данные: текст диагностики переполнения буфера источника —
; @does  единственная диагностика без номера строки (SPEC/L4-SELFHOST.txt,
; @does  раздел 5А); печать — словом prints.
text tbig "вход слишком большой"

; @method biginput ( -- )
; @in    нет
; @out   нет; не возвращается: строка выводится в stdout, затем программа
; @out   завершается кодом 16
; @does  Диагностика переполнения буфера источника (SPEC/L4-SELFHOST.txt,
; @does  раздел 5А): печатает «вход слишком большой» с переводом строки
; @does  и завершает программу словом QUIT (HALT 16 — ошибка входа
; @does  инструмента, SPEC/L3-UBRICK.txt, раздел 4.1).
; @depends tbig, prints, cr, QUIT
: biginput
  tbig prints cr QUIT ;

; @method readstep ( cur -- cur' done )
; @in    cur: слово — адрес следующего байта буфера источника
; @out   cur': слово — адрес следующего байта после шага
; @out   done: слово — 0: байт прочитан и записан в буфер; 1: EOF
; @does  Один шаг чтения stdin в буфер источника (SPEC/L4-SELFHOST.txt,
; @does  раздел 5А): keyok читает байт; байт при наличии места (roomok) —
; @does  storebyte пишет его, шаг возвращает 0; буфер полон — biginput
; @does  (не возвращается); EOF — 1, курсор не меняется.
; @depends keyok, roomok, storebyte, biginput
: readstep
  keyok
  IF
    OVER roomok
    IF storebyte 0 ELSE DROP DROP biginput THEN
  ELSE
    1
  THEN ;

; @method printu ( u -- )
; @in    u: слово — значение 0..2^64-1
; @out   нет (цифры выводятся в stdout, EMIT)
; @does  Печатает десятичное число (SPEC/L4-SELFHOST.txt, раздел 5А, как
; @does  printu дизассемблера): старшие разряды — рекурсивный вызов
; @does  с частным от UDIV 10, затем младший разряд — остаток UMOD 10
; @does  + '0'; u = 0 даёт «0»; кирпич листинга и диагностики fail.
; @depends UDIV, UMOD, ADD, EMIT, printu
: printu
  DUP 10 UDIV SWAP 10 UMOD
  SWAP DUP IF printu ELSE DROP THEN
  48 ADD EMIT ;

; Клетки печати слова: pa — адрес следующего байта, pl — сколько байтов
; осталось (printw).
var pa
var pl

; @method pwstep ( -- done )
; @in    нет (клетки pa, pl — состояние печати)
; @out   done: слово — 0: байт выведен; 1: байтов больше нет
; @does  Один шаг печати слова: pl = 0 — стоп; байт по адресу pa — EMIT,
; @does  pa + 1, pl - 1; кирпич printw.
; @depends pa, pl, EQ, LOAD8, EMIT, ADD, SUB
: pwstep
  pl LOAD64 0 EQ IF 1 EXIT THEN
  pa LOAD64 LOAD8 EMIT
  pa LOAD64 1 ADD pa STORE64
  pl LOAD64 1 SUB pl STORE64
  0 ;

; @method printw ( a l -- )
; @in    a: слово — адрес первого байта слова
; @in    l: слово — число байтов слова
; @out   нет (байты слова выводятся в stdout, EMIT)
; @does  Печатает l байтов с адреса a: слова листинга, аргументы
; @does  (lexpstep) и остаток строк DS/DZ (dsline).
; @depends pa, pl, pwstep
: printw
  pl STORE64 pa STORE64
  BEGIN pwstep UNTIL ;

; @method tuasm ( -- addr )
; @in    нет
; @out   addr: слово — адрес строки «uAsm: строка » (UTF-8 + 0)
; @does  Данные: префикс диагностической строки ассемблера (SPEC/
; @does  L4-SELFHOST.txt, раздел 5А: «uAsm: строка N: текст»); печать —
; @does  словом prints, номер строки — printu; кирпич fail.
text tuasm "uAsm: строка "

; @method targs ( -- addr )
; @in    нет
; @out   addr: слово — адрес строки «слишком много аргументов» (UTF-8 + 0)
; @does  Данные: текст ошибки ёмкости буфера аргументов (SPEC/
; @does  L4-SELFHOST.txt, раздел 5А: больше 256 аргументов DB/DW в одной
; @does  строке); печать — fail.
text targs "слишком много аргументов"

; @method fail ( a -- )
; @in    a: слово — адрес текста ошибки (Z-строка)
; @out   нет; не возвращается: строка выводится в stdout, затем программа
; @out   завершается кодом 16
; @does  Диагностика ошибки входа (SPEC/L4-SELFHOST.txt, раздел 5А):
; @does  печатает «uAsm: строка N: » (tuasm, номер строки ln, printu,
; @does  двоеточие и пробел), текст ошибки (prints), перевод строки
; @does  и завершает программу словом QUIT (HALT 16); образ при ошибке
; @does  не выводится.
; @depends tuasm, ln, printu, EMIT, space, prints, cr, QUIT
: fail
  tuasm prints
  ln LOAD64 printu
  58 EMIT space
  prints cr QUIT ;

; Клетка печати аргументов: ai — индекс следующей пары буфера аргументов.
var ai

; @method isdsdz ( -- ф )
; @in    нет (клетки wa, wl — первое слово строки)
; @out   ф: слово — 1: первое слово — директива DS или DZ; 0: иначе
; @does  Признак строки директивы данных DS/DZ (SPEC/L2-UASM.txt,
; @does  раздел 6): слово из двух байтов — «D» (68) и «S» (83) либо «Z»
; @does  (90); роль слова определяет позиция в строке (раздел 3), имя
; @does  метки «DS:» директивой не считается; директива берёт остаток
; @does  строки целиком — строковый литерал, а не слова-аргументы;
; @does  кирпичи doline и listline.
; @depends wa, wl, EQ, not, LOAD8, LOAD64, ADD, DUP, DROP, IF, EXIT, THEN
: isdsdz
  wl LOAD64 2 EQ not IF 0 EXIT THEN
  wa LOAD64 LOAD8 68 EQ not IF 0 EXIT THEN
  wa LOAD64 1 ADD LOAD8 DUP 83 EQ IF DROP 1 EXIT THEN
  90 EQ ;

; @method lexmark ( a l -- )
; @in    a: слово — адрес первого байта слова-аргумента
; @in    l: слово — число байтов слова-аргумента
; @out   нет (пометка выводится в stdout, EMIT/printu)
; @does  Печатает лексическую пометку слова-аргумента (листинг подшага 3):
; @does  числовой литерал — «#» и значение по модулю 2^64 (numlit, lexv,
; @does  printu), цифры верны, но вне диапазона -2^63..2^64-1 — «!» (33),
; @does  имя — «*» (42), прочее — «?» (63); классификация — эталон
; @does  tools/uasm_lex.py (parse_number, in_literal_range, is_name).
; @depends numlit, isname, lexv, printu, EMIT, LOAD64, EQ, DUP, DROP,
; @depends OVER, IF, ELSE, THEN
: lexmark
  OVER OVER numlit DUP
  IF
    DUP 1 EQ
    IF DROP DROP DROP 35 EMIT lexv LOAD64 printu
    ELSE DROP DROP DROP 33 EMIT
    THEN
  ELSE
    DROP
    isname IF 42 EMIT ELSE 63 EMIT THEN
  THEN ;

; @method lexpstep ( -- done )
; @in    нет (клетки ai, argc — состояние печати; буфер аргументов)
; @out   done: слово — 0: аргумент с пометкой выведен; 1: аргументов
; @out   больше нет
; @does  Один шаг печати аргументов с пометками (листинг подшага 3):
; @does  пара ai лежит по адресу argbase + ai * 16 — адрес слова (LOAD64)
; @does  и длина (LOAD64 с адреса пары + 8); перед аргументом — пробел,
; @does  за ним — слово (printw) и пометка (lexmark); кирпич lexlist.
; @depends ai, argc, argbase, LTU, not, MUL, ADD, LOAD64, space, printw,
; @depends lexmark, STORE64, IF, EXIT, THEN
: lexpstep
  ai LOAD64 argc LOAD64 LTU not IF 1 EXIT THEN
  space
  ai LOAD64 16 MUL argbase ADD DUP LOAD64 SWAP 8 ADD LOAD64
  OVER OVER printw
  lexmark
  ai LOAD64 1 ADD ai STORE64
  0 ;

; @method lexlist ( -- )
; @in    нет (клетка argc и буфер аргументов — аргументы строки)
; @out   нет (аргументы с пометками выводятся в stdout)
; @does  Печатает аргументы строки с лексическими пометками (листинг
; @does  подшага 3): пары буфера аргументов по порядку, перед каждым —
; @does  пробел, за каждым — пометка lexmark; кирпич listline.
; @depends ai, lexpstep
: lexlist
  0 ai STORE64
  BEGIN lexpstep UNTIL ;

; @method dsline ( -- )
; @in    нет (клетки ra, rl — остаток строки после DS/DZ)
; @out   нет (остаток и пометка выводятся в stdout)
; @does  Печатает литерал директивы DS/DZ (листинг подшага 3): остаток
; @does  строки целиком (printw — пробелы внутри литерала значимы,
; @does  SPEC/L2-UASM.txt, раздел 2; буфер аргументов для DS/DZ не
; @does  заполняется), затем скан parsestr — «#» и длина декодированных
; @does  байтов (sl, printu) либо «!» (33) при ошибке; кирпич listline.
; @depends ra, rl, parsestr, sl, printw, printu, space, EMIT, LOAD64,
; @depends OVER, DUP, DROP, IF, ELSE, THEN
: dsline
  space
  ra LOAD64 rl LOAD64
  OVER OVER printw
  OVER OVER parsestr
  IF DROP DROP 35 EMIT sl LOAD64 printu
  ELSE DROP DROP 33 EMIT
  THEN ;

; @method listline ( -- )
; @in    нет (клетки ln, wa, wl, argc, ra, rl и буфер аргументов — строка)
; @out   нет (строка листинга выводится в stdout)
; @does  Промежуточное поведение подшагов 2-3 (SPEC/L4-SELFHOST.txt,
; @does  раздел 5А; заменяется разбором строки в запись в подшаге 4):
; @does  печатает строку листинга «N:слово[=код] …» — номер строки
; @does  (printu), двоеточие, первое слово (printw), код мнемоники
; @does  после «=» (mnem, printu); дальше DS/DZ — остаток строки
; @does  целиком со сканом литерала (dsline), иначе — аргументы
; @does  с лексическими пометками (lexlist); перевод строки в конце;
; @does  пустые строки и комментарии молчат (их отсеивает doline).
; @depends ln, printu, wa, wl, printw, mnem, isdsdz, dsline, lexlist, cr,
; @depends EMIT
: listline
  ln LOAD64 printu
  58 EMIT
  wa LOAD64 wl LOAD64 printw
  mnem IF 61 EMIT printu THEN
  isdsdz IF dsline ELSE lexlist THEN
  cr ;

; @method doline ( s q -- )
; @in    s: слово — адрес первого байта строки буфера
; @in    q: слово — адрес за последним байтом строки (на LF либо be)
; @out   нет (строка обрабатывается; вывод подшага 3 — listline)
; @does  Обрабатывает одну строку (SPEC/L4-SELFHOST.txt, раздел 5А):
; @does  снимает концевые CR (crstep), отрезает комментарий «;» вне
; @does  кавычек (findsemi), снимает крайние пробелы и табуляции
; @does  (rtrim, ltrim); пустая строка или комментарий — тишина; иначе
; @does  splitword (первое слово и остаток); буфер аргументов заполняется
; @does  только для не DS/DZ строк (isdsdz: литерал DS/DZ берёт остаток
; @does  целиком, SPEC/L2-UASM.txt, раздел 6), затем listline. Подшаг 4
; @does  заменит listline разбором строки в запись.
; @depends crstep, findsemi, rtrim, ltrim, LTU, not, splitword, isdsdz,
; @depends splitargs, listline
: doline
  BEGIN crstep UNTIL
  findsemi
  rtrim ltrim
  OVER OVER LTU not IF DROP DROP EXIT THEN
  splitword
  isdsdz not IF splitargs THEN
  listline ;

; @method main ( -- )
; @in    нет (вход инструмента — байты stdin, KEY)
; @out   нет (выход подшага 3 — листинг строк в stdout, EMIT; код
; @out   завершения 0 — успех, 16 — ошибка входа)
; @does  Каркас ассемблера (SPEC/L4-SELFHOST.txt, раздел 5А): читает
; @does  stdin целиком в буфер источника (readstep, конец — в be), ставит
; @does  bp на начало буфера и ln = 1, проходит строки (linestep
; @does  до конца) и завершается BYE; пустой вход — пустой вывод.
; @does  Разбор в записи и сборка образа — подшаги 4-6.
; @depends srcbase, readstep, be, bp, ln, linestep, BYE
: main
  srcbase
  BEGIN readstep UNTIL
  be STORE64
  srcbase bp STORE64
  1 ln STORE64
  BEGIN linestep UNTIL
  BYE ;
