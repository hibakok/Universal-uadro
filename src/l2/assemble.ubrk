; @uadro
; @file    src/l2/assemble.ubrk
; @layer   L2
; @branch  l2.uasm.assemble
; @desc    Ассемблер uAsm — собственное воплощение Этапа 4: вход — текст
; @desc    uAsm в stdin (KEY), выход — образ UVM в stdout (EMIT); код 0 —
; @desc    успех, 16 — ошибка входа (SPEC/L4-SELFHOST.txt, разделы 4 и 5А).
; @desc    Подшаг 1 (каркас и память): use-включение asmmem.ubrk — вход
; @desc    читается целиком в буфер источника 512 КиБ (readstep), вход
; @desc    сверх лимита — строка «вход слишком большой» и код 16. Подшаг 2
; @desc    (строки и слова): use-включения asmwords.ubrk (деление буфера
; @desc    на строки, чистка строки, первое слово, аргументы DB/DW парами)
; @desc    и asmmnem.ubrk (таблица мнемоник, поиск кода, признак imm64).
; @desc    Подшаг 3 (литералы и имена): use-включение asmlex.ubrk —
; @desc    числовые формы, минус, диапазон, имена и скан строковых
; @desc    литералов DS/DZ. Подшаг 4 (разбор строки в запись):
; @desc    use-включение asmline.ubrk — каждая строка разбирается в запись
; @desc    по порядку раздела 7 SPEC/L2-UASM.txt; ошибки разбора строки —
; @desc    диагностика «uAsm: строка N: текст» (errhead, fail, failx)
; @desc    и код 16. Подшаг 5 (таблица символов и проход 1):
; @desc    use-включение asmsym.ubrk — запись и поиск имён; p1step
; @desc    определяет метки адресами и константы значениями, recsize
; @desc    копит адрес. Подшаг 6 (проход 2 и вывод образа): use-включение
; @desc    asmcode.ubrk — p2step кодирует записи в буфер образа; клетка ps
; @desc    выбирает шаг записи (p1step либо p2step), проход 2 повторно
; @desc    проходит строки; imgout выводит байты [imgbase, vc) при успехе,
; @desc    при ошибке образ не выводится — только диагностика (SPEC/
; @desc    L4-SELFHOST.txt, раздел 5А).
use asmmem.ubrk
use asmwords.ubrk
use asmmnem.ubrk
use asmlex.ubrk
use asmline.ubrk
use asmsym.ubrk
use asmcode.ubrk

; @method tbig ( -- addr )
; @in    нет
; @out   addr: слово — адрес строки «вход слишком большой» (UTF-8 + 0)
; @does  Данные: текст диагностики переполнения буфера источника —
; @does  единственная диагностика без номера строки (SPEC/L4-SELFHOST.txt,
; @does  раздел 5А); печать — словом prints.
text tbig "вход слишком большой"

; @method biginput ( -- )
; @in    нет
; @out   нет; не возвращается: строка выводится в stdout, затем программа
; @out   завершается кодом 16
; @does  Диагностика переполнения буфера источника (SPEC/L4-SELFHOST.txt,
; @does  раздел 5А): печатает «вход слишком большой» с переводом строки
; @does  и завершает программу словом QUIT (HALT 16 — ошибка входа
; @does  инструмента, SPEC/L3-UBRICK.txt, раздел 4.1).
; @depends tbig, prints, cr, QUIT
: biginput
  tbig prints cr QUIT ;

; @method readstep ( cur -- cur' done )
; @in    cur: слово — адрес следующего байта буфера источника
; @out   cur': слово — адрес следующего байта после шага
; @out   done: слово — 0: байт прочитан и записан в буфер; 1: EOF
; @does  Один шаг чтения stdin в буфер источника (SPEC/L4-SELFHOST.txt,
; @does  раздел 5А): keyok читает байт; байт при наличии места (roomok) —
; @does  storebyte пишет его, шаг возвращает 0; буфер полон — biginput
; @does  (не возвращается); EOF — 1, курсор не меняется.
; @depends keyok, roomok, storebyte, biginput
: readstep
  keyok
  IF
    OVER roomok
    IF storebyte 0 ELSE DROP DROP biginput THEN
  ELSE
    1
  THEN ;

; @method printu ( u -- )
; @in    u: слово — значение 0..2^64-1
; @out   нет (цифры выводятся в stdout, EMIT)
; @does  Печатает десятичное число (SPEC/L4-SELFHOST.txt, раздел 5А, как
; @does  printu дизассемблера): старшие разряды — рекурсивный вызов
; @does  с частным от UDIV 10, затем младший разряд — остаток UMOD 10
; @does  + '0'; u = 0 даёт «0»; кирпич диагностики errhead.
; @depends UDIV, UMOD, ADD, EMIT, printu
: printu
  DUP 10 UDIV SWAP 10 UMOD
  SWAP DUP IF printu ELSE DROP THEN
  48 ADD EMIT ;

; Клетки печати слова: pa — адрес следующего байта, pl — сколько байтов
; осталось (printw).
var pa
var pl

; @method pwstep ( -- done )
; @in    нет (клетки pa, pl — состояние печати)
; @out   done: слово — 0: байт выведен; 1: байтов больше нет
; @does  Один шаг печати слова: pl = 0 — стоп; байт по адресу pa — EMIT,
; @does  pa + 1, pl - 1; кирпич printw.
; @depends pa, pl, EQ, LOAD8, EMIT, ADD, SUB
: pwstep
  pl LOAD64 0 EQ IF 1 EXIT THEN
  pa LOAD64 LOAD8 EMIT
  pa LOAD64 1 ADD pa STORE64
  pl LOAD64 1 SUB pl STORE64
  0 ;

; @method printw ( a l -- )
; @in    a: слово — адрес первого байта слова
; @in    l: слово — число байтов слова
; @out   нет (байты слова выводятся в stdout, EMIT)
; @does  Печатает l байтов с адреса a: слово X диагностики failx.
; @depends pa, pl, pwstep
: printw
  pl STORE64 pa STORE64
  BEGIN pwstep UNTIL ;

; @method tuasm ( -- addr )
; @in    нет
; @out   addr: слово — адрес строки «uAsm: строка » (UTF-8 + 0)
; @does  Данные: префикс диагностической строки ассемблера (SPEC/
; @does  L4-SELFHOST.txt, раздел 5А: «uAsm: строка N: текст»); печать —
; @does  словом prints, номер строки — printu; кирпич errhead.
text tuasm "uAsm: строка "

; @method targs ( -- addr )
; @in    нет
; @out   addr: слово — адрес строки «слишком много аргументов» (UTF-8 + 0)
; @does  Данные: текст ошибки ёмкости буфера аргументов (SPEC/
; @does  L4-SELFHOST.txt, раздел 5А: больше 256 аргументов DB/DW в одной
; @does  строке); печать — fail.
text targs "слишком много аргументов"

; @method errhead ( -- )
; @in    нет (клетка ln — номер текущей строки)
; @out   нет (префикс выводится в stdout, EMIT)
; @does  Печатает префикс диагностической строки «uAsm: строка N: »
; @does  (tuasm, номер строки ln — printu, двоеточие и пробел; SPEC/
; @does  L4-SELFHOST.txt, раздел 5А); кирпичи fail и failx.
; @depends tuasm, ln, printu, EMIT, space, prints
: errhead
  tuasm prints
  ln LOAD64 printu
  58 EMIT space ;

; @method fail ( a -- )
; @in    a: слово — адрес текста ошибки (Z-строка)
; @out   нет; не возвращается: строка выводится в stdout, затем программа
; @out   завершается кодом 16
; @does  Диагностика ошибки входа без слова X (SPEC/L4-SELFHOST.txt,
; @does  раздел 5А): errhead, текст ошибки (prints), перевод строки
; @does  и завершение словом QUIT (HALT 16); образ при ошибке
; @does  не выводится.
; @depends errhead, prints, cr, QUIT
: fail
  errhead prints cr QUIT ;

; @method failx ( a l t -- )
; @in    a: слово — адрес первого байта слова X сообщения
; @in    l: слово — число байтов слова X
; @in    t: слово — адрес текста ошибки с местом для X в конце (Z-строка)
; @out   нет; не возвращается: строка выводится в stdout, затем программа
; @out   завершается кодом 16
; @does  Диагностика ошибки входа со словом X (SPEC/L4-SELFHOST.txt,
; @does  раздел 5А; тексты ошибок с X — SPEC/L2-UASM.txt, раздел 7):
; @does  errhead, текст ошибки (prints), слово X (printw), перевод
; @does  строки и завершение словом QUIT (HALT 16); образ при ошибке
; @does  не выводится.
; @depends errhead, printw, prints, cr, QUIT
: failx
  errhead prints printw cr QUIT ;

; Клетка прохода 1: va — текущий адрес (адрес следующей записи образа;
; метка получает его значением — SPEC/L2-UASM.txt, разделы 3 и 7).
var va

; Клетка выбора прохода: ps — 0: doline заканчивается p1step (проход 1 —
; таблица символов и адреса), 1: p2step (проход 2 — кодирование записи
; в буфер образа); ставится словом main перед каждым проходом.
var ps

; @method p1addr ( -- )
; @in    нет
; @out   нет; va = 0, таблица символов пуста
; @does  Начальное состояние прохода 1 (SPEC/L2-UASM.txt, раздел 7):
; @does  адрес первой записи 0, таблица символов пуста (symreset);
; @does  кирпич main.
; @depends va, symreset
: p1addr
  0 va STORE64
  symreset ;

; @method recsize ( -- n )
; @in    нет (клетки записи rk, rc, argc, sl — вид и данные записи)
; @out   n: слово — размер записи в байтах образа
; @does  Размер записи для адресов прохода 1 (SPEC/L2-UASM.txt, раздел
; @does  7, record_size эталона): инструкция с полем imm64 (hasimm) — 9
; @does  байтов, без — 1; DB — по байту на аргумент (argc); DW — по 8;
; @does  DS — длина литерала (sl), DZ — длина + 1 (байт 0); метка
; @does  и константа байтов не дают; кирпич p1step.
; @depends rk, rc, argc, sl, hasimm, EQ, DUP, DROP, IF, ELSE, THEN, EXIT,
; @depends MUL, ADD, LOAD64
: recsize
  rk LOAD64
  DUP 3 EQ IF DROP rc LOAD64 hasimm IF 9 ELSE 1 THEN EXIT THEN
  DUP 4 EQ IF DROP argc LOAD64 EXIT THEN
  DUP 5 EQ IF DROP argc LOAD64 8 MUL EXIT THEN
  DUP 6 EQ IF DROP sl LOAD64 EXIT THEN
  DUP 7 EQ IF DROP sl LOAD64 1 ADD EXIT THEN
  DROP 0 ;

; @method p1step ( -- )
; @in    нет (клетки записи rk, rn, wa, rv — разобранная строка)
; @out   нет; метка и константа — символы в таблице, va — адрес
; @out   следующей записи
; @does  Обрабатывает запись прохода 1 (SPEC/L2-UASM.txt, раздел 7,
; @does  pass1 эталона): метка (rk = 1) — символ со значением va (адрес
; @does  следующей записи; метка в конце текста получит адрес конца
; @does  образа); константа (rk = 2) — символ со значением rv; иная
; @does  запись — va растёт на recsize; ошибки symdef прекращают проход
; @does  (fail/failx, код 16); кирпич doline.
; @depends rk, rn, wa, rv, va, symdef, recsize, EQ, DUP, DROP, IF, EXIT,
; @depends THEN, ADD, STORE64, LOAD64
: p1step
  rk LOAD64
  DUP 1 EQ IF DROP wa LOAD64 rn LOAD64 va LOAD64 symdef EXIT THEN
  DUP 2 EQ IF DROP wa LOAD64 rn LOAD64 rv LOAD64 symdef EXIT THEN
  DROP
  recsize va LOAD64 ADD va STORE64 ;

; @method doline ( s q -- )
; @in    s: слово — адрес первого байта строки буфера
; @in    q: слово — адрес за последним байтом строки (на LF либо be)
; @out   нет (строка обрабатывается; шаг записи выбирает клетка ps:
; @out   p1step либо p2step)
; @does  Обрабатывает одну строку (SPEC/L4-SELFHOST.txt, раздел 5А):
; @does  снимает концевые CR (crstep), отрезает комментарий «;» вне
; @does  кавычек (findsemi), снимает крайние пробелы и табуляции
; @does  (rtrim, ltrim); пустая строка или комментарий — тишина; иначе
; @does  splitword (первое слово и остаток), директива DB/DW — splitargs
; @does  (аргументы парами в буфер аргументов: лимит 256 пар — только
; @does  аргументы DB/DW, SPEC/L4-SELFHOST.txt, раздел 5А; операнд
; @does  инструкции и литерал DS/DZ — текст ra/rl, не слова-аргументы),
; @does  parseline (запись) и шаг записи: ps = 0 — p1step (проход 1:
; @does  метки и константы — символы, адрес записи — va), ps = 1 —
; @does  p2step (проход 2: кодирование записи в буфер образа,
; @does  asmcode.ubrk); проход 2 повторно разбирает те же строки —
; @does  ошибки разбора там невозможны, ошибки значений решает p2step.
; @depends crstep, findsemi, rtrim, ltrim, splitword, isdbdw, splitargs,
; @depends parseline, ps, p1step, p2step, LTU, not, IF, THEN, LOAD64
: doline
  BEGIN crstep UNTIL
  findsemi
  rtrim ltrim
  OVER OVER LTU not IF DROP DROP EXIT THEN
  splitword
  isdbdw IF splitargs THEN
  parseline
  ps LOAD64 IF p2step ELSE p1step THEN ;

; Клетка вывода образа: oa — адрес следующего байта вывода (outstep).
var oa

; @method outstep ( -- done )
; @in    нет (клетки oa, vc — состояние вывода)
; @out   done: слово — 0: байт образа выведен, вывод продолжается; 1:
; @out   байтов образа больше нет (oa достиг vc)
; @does  Один шаг вывода образа (SPEC/L4-SELFHOST.txt, раздел 5А):
; @does  байт по адресу oa — EMIT, oa растёт; кирпич imgout.
; @depends oa, vc, GEU, LOAD8, EMIT, ADD, STORE64, LOAD64, IF, EXIT, THEN
: outstep
  oa LOAD64 vc LOAD64 GEU IF 1 EXIT THEN
  oa LOAD64 LOAD8 EMIT
  oa LOAD64 1 ADD oa STORE64
  0 ;

; @method imgout ( -- )
; @in    нет (буфер образа заполнен проходом 2 — байты [imgbase, vc))
; @out   нет (байты образа выводятся в stdout, EMIT)
; @does  Выводит собранный образ (SPEC/L4-SELFHOST.txt, раздел 5А: выход —
; @does  образ целиком из буфера образа при успехе); пустой образ —
; @does  пустой вывод; кирпич main.
; @depends oa, imgbase, outstep, STORE64, BEGIN, UNTIL
: imgout
  imgbase oa STORE64
  BEGIN outstep UNTIL ;

; @method main ( -- )
; @in    нет (вход инструмента — байты stdin, KEY)
; @out   нет (выход — образ UVM в stdout, EMIT; код завершения 0 —
; @out   успех, 16 — ошибка входа)
; @does  Ассемблер uAsm (SPEC/L4-SELFHOST.txt, раздел 5А; SPEC/
; @does  L2-UASM.txt, раздел 7): читает stdin целиком в буфер источника
; @does  (readstep, конец — be); проход 1 (ps = 0): p1addr (va = 0,
; @does  пустая таблица символов), строки — linestep/doline, каждая
; @does  запись — p1step (метки и константы — символы, адрес записи —
; @does  va); проход 2 (ps = 1): курсор образа vc — imgbase, строки
; @does  проходят повторно, каждая запись — p2step (кодирование в буфер
; @does  образа, значения имён — из таблицы прохода 1); успех — imgout
; @does  (байты [imgbase, vc)) и BYE; пустой вход — пустой образ; ошибка
; @does  любого прохода — диагностика fail/failx и код 16, образ
; @does  не выводится.
; @depends srcbase, readstep, be, ps, bp, ln, p1addr, linestep, vc,
; @depends imgbase, imgout, BYE, STORE64, BEGIN, UNTIL, LOAD64
: main
  srcbase
  BEGIN readstep UNTIL
  be STORE64
  0 ps STORE64
  srcbase bp STORE64
  1 ln STORE64
  p1addr
  BEGIN linestep UNTIL
  1 ps STORE64
  srcbase bp STORE64
  1 ln STORE64
  imgbase vc STORE64
  BEGIN linestep UNTIL
  imgout
  BYE ;
