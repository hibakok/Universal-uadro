; @uadro
; @file    src/nested_calls.ubrk
; @layer   L3
; @branch  t0.ubrick.integration
; @desc    Программа «вложенные вычисления»: var-ячейки x/y/i, вызовы
; @desc    sub1/sub2 глубиной два, счётный цикл BEGIN/UNTIL
; @desc    с производным словом dec (SPEC/L3-UBRICK.txt, разделы 4.2,
; @desc    5 и 6); поведение эталона src/nested_calls.uasm Этапа 2:
; @desc    вывод "!", стек [111, 222], пустой RS, код 0.

var x
var y
var i

: sub2
222 x STORE64 ;

: sub1
111 y STORE64
sub2 ;

: wait0
BEGIN
i LOAD64 dec i STORE64
i LOAD64 0 EQ
UNTIL ;

: main
sub1
3 i STORE64
wait0
y LOAD64
x LOAD64
'!' EMIT ;
