; @uadro
; @file    src/l1/mem.ubrk
; @layer   L1
; @branch  l1.uvm.emu
; @desc    Эмулятор UVM — память инструмента: use-включение главного файла
; @desc    src/l1/emu.ubrk (SPEC/L4-SELFHOST.txt, раздел 5Б, подшаги 1-6).
; @desc    Раскладка ОЗУ инструмента — слова-адреса буферов и клеток
; @desc    состояния гостя; кирпичи чтения образа гостя из stdin (keyok,
; @desc    imgroom, imgput), доступа к памяти гостя по байтам и словам
; @desc    (gloadbyte, gloadword, gstorebyte, gstoreword — ловушка 7 вне
; @desc    ОЗУ гостя), стеков гостя (gpush/gpop/gpick — ловушки 2/3,
; @desc    rpush/rpop — ловушки 4/5) и начального состояния машины гостя
; @desc    (greset). Обработчики CALL/RET (подшаг 6, opsjump.ubrk)
; @desc    используют rpush/rpop.

; Раскладка ОЗУ инструмента (SPEC/L4-SELFHOST.txt, раздел 5Б): адреса
; фиксированы, лимиты — часть контракта; собственный образ инструмента
; загружается с адреса 0 и лежит ниже буферов.

; @method grambase ( -- addr )
; @in    нет
; @out   addr: слово — адрес 0x10000, первый байт ОЗУ гостя в ОЗУ узла
; @does  Раскладка ОЗУ (SPEC/L4-SELFHOST.txt, раздел 5Б): ОЗУ гостя —
; @does  512 КиБ, образ с stdin пишется с адреса гостя 0; доступ
; @does  к памяти гостя — через базу: адрес гостя a -> 0x10000 + a.
: grambase
  0x10000 ;

; @method gramlimit ( -- addr )
; @in    нет
; @out   addr: слово — адрес 0x90000, за последним байтом ОЗУ гостя
; @does  Предел образа гостя в ОЗУ узла: вход длиннее 512 КиБ — ловушка
; @does  7 гостя до начала исполнения — код 7, вывод пуст (раздел 5Б);
; @does  кирпич imgstep главного файла emu.ubrk.
: gramlimit
  0x90000 ;

; @method gramsize ( -- n )
; @in    нет
; @out   n: слово — 0x80000, размер ОЗУ гостя в байтах (512 КиБ)
; @does  Размер ОЗУ гостя: адрес гостя обязан быть меньше gramsize
; @does  прежде сложения с базой — перенос слова при a + grambase
; @does  ошибочно прошёл бы проверку по пределу; кирпич gloadbyte.
: gramsize
  0x80000 ;

; @method gdsbase ( -- addr )
; @in    нет
; @out   addr: слово — адрес 0x90000, первый байт стека данных гостя
; @does  Раскладка ОЗУ: стек данных гостя DS — 256 слов, растёт вверх;
; @does  кирпичи стеков — gpush/gpop/gpick (подшаг 3).
: gdsbase
  0x90000 ;

; @method gdslimit ( -- addr )
; @in    нет
; @out   addr: слово — адрес 0x90800, за последним байтом стека DS гостя
; @does  Раскладка ОЗУ: предел стека данных гостя (256 слов по 8 байтов);
; @does  переполнение — ловушка 3 (gpush, подшаг 3).
: gdslimit
  0x90800 ;

; @method grsbase ( -- addr )
; @in    нет
; @out   addr: слово — адрес 0x90800, первый байт стека возвратов гостя
; @does  Раскладка ОЗУ: стек возвратов гостя RS — 64 слова, растёт вверх;
; @does  кирпичи стеков — rpush/rpop (подшаг 3).
: grsbase
  0x90800 ;

; @method grslimit ( -- addr )
; @in    нет
; @out   addr: слово — адрес 0x90A00, за последним байтом стека RS гостя
; @does  Раскладка ОЗУ: предел стека возвратов гостя (64 слова по 8);
; @does  переполнение — ловушка 5 (rpush, подшаг 3).
: grslimit
  0x90A00 ;

; @method gpcaddr ( -- addr )
; @in    нет
; @out   addr: слово — адрес 0x90A00, клетка gpc — PC гостя
; @does  Раскладка ОЗУ: клетки состояния гостя с 0x90A00; gpc хранит
; @does  счётчик команд гостя, снимок машины читается из ОЗУ узла
; @does  по раскладке (раздел 5Б: тест-кирпич run_saved, t0.infra.tests).
: gpcaddr
  0x90A00 ;

; @method gdspaddr ( -- addr )
; @in    нет
; @out   addr: слово — адрес 0x90A08, клетка gdsp — слов в DS гостя
; @does  Раскладка ОЗУ: gdsp хранит число слов в стеке данных гостя
; @does  (0 — пуст); снимок DS — байты [gdsbase, gdsbase + gdsp * 8).
: gdspaddr
  0x90A08 ;

; @method grspaddr ( -- addr )
; @in    нет
; @out   addr: слово — адрес 0x90A10, клетка grsp — слов в RS гостя
; @does  Раскладка ОЗУ: grsp хранит число слов в стеке возвратов гостя
; @does  (0 — пуст); снимок RS — байты [grsbase, grsbase + grsp * 8).
: grspaddr
  0x90A10 ;

; @method keyok ( -- c 1 | 0 )
; @in    нет (байт входа читается из stdin, KEY)
; @out   pair: c и флаг 1 — прочитан байт; либо 0 без байта — EOF
; @does  Читает байт входа инструмента (KEY): EOF даёт только флаг 0,
; @does  байт — c и флаг 1; дубль кирпича keyok ассемблера (asmmem.ubrk)
; @does  — ветви изолированы (CHARTER.txt, п. 2); кирпич imgstep
; @does  главного файла emu.ubrk.
; @depends KEY
: keyok
  KEY DUP -1 EQ IF DROP 0 EXIT THEN 1 ;

; @method imgroom ( cur -- flag )
; @in    cur: слово — адрес узла следующего байта образа гостя
; @out   flag: слово — 1: байт влезает (cur < gramlimit); 0: ОЗУ гостя
; @out   полно — ловушка 7
; @does  Проверка ёмкости образа гостя перед записью байта: вход сверх
; @does  512 КиБ обязан закончиться ловушкой 7 гостя до начала
; @does  исполнения (SPEC/L4-SELFHOST.txt, раздел 5Б); кирпич imgstep
; @does  главного файла emu.ubrk.
; @depends gramlimit, LTU
: imgroom
  gramlimit LTU ;

; @method imgput ( cur c -- cur' )
; @in    cur: слово — адрес узла следующего байта образа гостя
; @in    c: слово — прочитанный байт входа 0..255
; @out   cur': слово — адрес узла следующего байта после записи
; @does  Записывает байт c образа гостя по адресу узла cur (STORE8)
; @does  и возвращает cur + 1; кирпич imgstep главного файла emu.ubrk.
; @depends OVER, STORE8, ADD
: imgput
  OVER STORE8 1 ADD ;

; @method gloadbyte ( a -- b )
; @in    a: слово — адрес гостя
; @out   b: слово — байт ОЗУ гостя 0..255
; @does  Читает байт ОЗУ гостя (SPEC/L4-SELFHOST.txt, раздел 5Б: адрес
; @does  гостя a -> grambase + a): a >= gramsize — ловушка 7 гостя
; @does  (STOP, код 7) прежде сложения с базой — перенос слова при
; @does  a + grambase ошибочно прошёл бы проверку по пределу; кирпич
; @does  декодера (dec.ubrk) и группы «память» (opsmem.ubrk, подшаг 4).
; @depends gramsize, LTU, not, grambase, ADD, LOAD8, STOP
: gloadbyte
  DUP gramsize LTU not IF DROP 7 STOP THEN
  grambase ADD LOAD8 ;

; Клетки чтения слова гостя: gi — индекс байта 0..8, gw — накопленное
; значение, ga — адрес гостя младшего байта (gloadword).
var gi
var gw
var ga

; @method gwstep ( -- done )
; @in    нет (клетки gi, gw, ga — состояние чтения слова)
; @out   done: слово — 0: байт прочитан и накоплен; 1: все восемь байтов
; @out   прочитаны
; @does  Один шаг чтения слова ОЗУ гостя (как load_word эталона,
; @does  t0.uvm.core): байт по адресу гостя ga + gi — gloadbyte (ловушка
; @does  7 вне ОЗУ гостя), gw = gw + байт << 8 * gi, gi + 1; кирпич
; @does  gloadword.
; @depends gi, ga, gloadbyte, gw, MUL, SHL, ADD, STORE64, LOAD64, GEU, IF
: gwstep
  gi LOAD64 8 GEU IF 1 EXIT THEN
  ga LOAD64 gi LOAD64 ADD gloadbyte
  gi LOAD64 8 MUL SHL
  gw LOAD64 ADD gw STORE64
  gi LOAD64 1 ADD gi STORE64
  0 ;

; @method gloadword ( a -- w )
; @in    a: слово — адрес гостя младшего байта слова
; @out   w: слово — 64-битное слово ОЗУ гостя (байты little-endian)
; @does  Читает восемь байтов LE из ОЗУ гостя (проверка каждого байта —
; @does  gloadbyte, ловушка 7): ga = a, gi = 0, gw = 0, затем gwstep до
; @does  готовности; кирпич декодера — поле imm64 (dec.ubrk) и обработчик
; @does  LOAD64 (opsmem.ubrk, подшаг 4).
; @depends ga, gi, gw, gwstep
: gloadword
  ga STORE64 0 gi STORE64 0 gw STORE64
  BEGIN gwstep UNTIL
  gw LOAD64 ;

; @method gpush ( w -- )
; @in    w: слово — слово для стека данных гостя
; @out   нет; слово w лежит в DS гостя, клетка gdsp увеличена на 1
; @does  Кладёт слово на стек данных гостя (как ds_push эталона,
; @does  t0.uvm.core): стек полон — gdsp не меньше ёмкости из раскладки
; @does  (gdsbase/gdslimit, 256 слов) — ловушка 3 гостя (STOP, код 3);
; @does  слово пишется STORE64 по gdsbase + gdsp * 8, gdsp + 1; кирпич
; @does  обработчиков группы «стек» (opsstack.ubrk, подшаг 3).
; @depends gdspaddr, gdslimit, gdsbase, SUB, UDIV, GEU, IF, DROP, STOP,
; @depends MUL, ADD, STORE64, LOAD64
: gpush
  gdspaddr LOAD64 gdslimit gdsbase SUB 8 UDIV GEU
  IF DROP 3 STOP THEN
  gdsbase gdspaddr LOAD64 8 MUL ADD STORE64
  gdspaddr LOAD64 1 ADD gdspaddr STORE64 ;

; @method gpop ( -- w )
; @in    нет (клетка gdsp — число слов в DS гостя)
; @out   w: слово — снятая вершина стека данных гостя
; @does  Снимает вершину стека данных гостя (как ds_pop эталона):
; @does  пустой стек (gdsp = 0) — ловушка 2 гостя (STOP, код 2); gdsp
; @does  уменьшается на 1, слово читается LOAD64 по gdsbase + gdsp * 8;
; @does  кирпич обработчиков группы «стек» (подшаг 3).
; @depends gdspaddr, EQ, IF, STOP, SUB, STORE64, gdsbase, MUL, ADD,
; @depends LOAD64
: gpop
  gdspaddr LOAD64 0 EQ IF 2 STOP THEN
  gdspaddr LOAD64 1 SUB gdspaddr STORE64
  gdsbase gdspaddr LOAD64 8 MUL ADD LOAD64 ;

; @method gpick ( d -- w )
; @in    d: слово — глубина элемента (0 — вершина DS гостя)
; @out   w: слово — копия элемента глубины d; стек гостя не меняется
; @does  Копия элемента глубины d стека данных гостя (как ds_pick
; @does  эталона): d не меньше gdsp (сравнение беззнаковое — imm64 может
; @does  быть до 2^64-1) — ловушка 2 гостя; слово читается LOAD64
; @does  по gdsbase + (gdsp - 1 - d) * 8; кирпич обработчиков DUP/OVER/
; @does  PICK (подшаг 3).
; @depends gdspaddr, DUP, GEU, IF, DROP, STOP, SUB, SWAP, MUL, gdsbase,
; @depends ADD, LOAD64
: gpick
  DUP gdspaddr LOAD64 GEU IF DROP 2 STOP THEN
  gdspaddr LOAD64 1 SUB SWAP SUB 8 MUL gdsbase ADD LOAD64 ;

; @method rpush ( w -- )
; @in    w: слово — слово для стека возвратов гостя
; @out   нет; слово w лежит в RS гостя, клетка grsp увеличена на 1
; @does  Кладёт слово на стек возвратов гостя (как rs_push эталона):
; @does  стек полон — grsp не меньше ёмкости из раскладки (grsbase/
; @does  grslimit, 64 слова) — ловушка 5 гостя (STOP, код 5); слово
; @does  пишется STORE64 по grsbase + grsp * 8, grsp + 1; кирпич
; @does  обработчика CALL (opsjump.ubrk, подшаг 6).
; @depends grspaddr, grslimit, grsbase, SUB, UDIV, GEU, IF, DROP, STOP,
; @depends MUL, ADD, STORE64, LOAD64
: rpush
  grspaddr LOAD64 grslimit grsbase SUB 8 UDIV GEU
  IF DROP 5 STOP THEN
  grsbase grspaddr LOAD64 8 MUL ADD STORE64
  grspaddr LOAD64 1 ADD grspaddr STORE64 ;

; @method rpop ( -- w )
; @in    нет (клетка grsp — число слов в RS гостя)
; @out   w: слово — снятая вершина стека возвратов гостя
; @does  Снимает вершину стека возвратов гостя (как rs_pop эталона):
; @does  пустой стек (grsp = 0) — ловушка 4 гостя (STOP, код 4); grsp
; @does  уменьшается на 1, слово читается LOAD64 по grsbase + grsp * 8;
; @does  кирпич обработчика RET (opsjump.ubrk, подшаг 6).
; @depends grspaddr, EQ, IF, STOP, SUB, STORE64, grsbase, MUL, ADD,
; @depends LOAD64
: rpop
  grspaddr LOAD64 0 EQ IF 4 STOP THEN
  grspaddr LOAD64 1 SUB grspaddr STORE64
  grsbase grspaddr LOAD64 8 MUL ADD LOAD64 ;

; @method gstorebyte ( addr val -- )
; @in    addr: слово — адрес гостя (глубже на стеке узла)
; @in    val: слово — значение; записывается его младший байт (вершина)
; @out   нет; младший байт val в ОЗУ гостя по адресу addr
; @does  Пишет младший байт val в ОЗУ гостя (как store_byte эталона,
; @does  t0.uvm.core; зеркально gloadbyte): addr не меньше gramsize —
; @does  ловушка 7 гостя (STOP, код 7) прежде сложения с базой — перенос
; @does  слова при addr + grambase ошибочно прошёл бы проверку; адрес
; @does  узла — grambase + addr, байт — STORE8; кирпич swstep и обработчик
; @does  STORE8 (opsmem.ubrk, подшаг 4).
; @depends SWAP, DUP, gramsize, LTU, not, IF, DROP, STOP, grambase, ADD,
; @depends STORE8
: gstorebyte
  SWAP DUP gramsize LTU not IF DROP DROP 7 STOP THEN
  grambase ADD STORE8 ;

; Клетки записи слова гостя: si — индекс байта 0..8, sv — значение,
; sa — адрес гостя младшего байта (gstoreword).
var sa
var sv
var si

; @method swstep ( -- done )
; @in    нет (клетки sa, sv, si — состояние записи слова)
; @out   done: слово — 0: байт записан; 1: все восемь байтов записаны
; @does  Один шаг записи слова в ОЗУ гостя (как store_word эталона):
; @does  адрес гостя sa + si, байт (sv >> 8 * si) AND 255 — gstorebyte
; @does  (ловушка 7 вне ОЗУ гостя), si + 1; кирпич gstoreword.
; @depends sa, si, LOAD64, ADD, sv, MUL, SHR, AND, gstorebyte, GEU, IF,
; @depends EXIT, STORE64
: swstep
  si LOAD64 8 GEU IF 1 EXIT THEN
  sa LOAD64 si LOAD64 ADD
  sv LOAD64 si LOAD64 8 MUL SHR 255 AND
  gstorebyte
  si LOAD64 1 ADD si STORE64
  0 ;

; @method gstoreword ( addr val -- )
; @in    addr: слово — адрес гостя младшего байта (глубже на стеке узла)
; @in    val: слово — значение; биты старше 64 игнорируются (вершина)
; @out   нет; восемь байтов val в ОЗУ гостя little-endian по адресу addr
; @does  Раскладывает слово val в восемь байтов LE ОЗУ гостя (как
; @does  store_word эталона): sa = addr, sv = val, si = 0, затем swstep
; @does  до готовности — каждый байт проверен gstorebyte (ловушка 7);
; @does  кирпич обработчика STORE64 (opsmem.ubrk, подшаг 4).
; @depends SWAP, sa, sv, si, STORE64, swstep, BEGIN, UNTIL
: gstoreword
  SWAP sa STORE64 sv STORE64 0 si STORE64
  BEGIN swstep UNTIL ;

; @method greset ( -- )
; @in    нет
; @out   нет; клетки gpc = 0, gdsp = 0, grsp = 0
; @does  Начальное состояние машины гостя (SPEC/L0-UVM.txt, раздел 2:
; @does  PC = 0, DS и RS пусты) после загрузки образа; кирпич main
; @does  главного файла emu.ubrk.
; @depends gpcaddr, gdspaddr, grspaddr, STORE64
: greset
  0 gpcaddr STORE64
  0 gdspaddr STORE64
  0 grspaddr STORE64 ;
