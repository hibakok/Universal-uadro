; @uadro
; @file    src/l1/tab.ubrk
; @layer   L1
; @branch  l1.uvm.emu
; @desc    Эмулятор UVM — дерево диапазонов: таблица обработчиков (SPEC/
; @desc    L4-SELFHOST.txt, раздел 5Б, подшаги 2-6): dispatch — вложенные IF
; @desc    по шести диапазонам SPEC/L0-UVM.txt (раздел 5), внутри — слова
; @desc    групп, по коду — CALL обработчика (ops*.ubrk, по файлу на
; @desc    группу, как t0.uvm.ops): все 38 опкодов v0.1 — «стек»
; @desc    (opsstack.ubrk), «память» (opsmem.ubrk), «арифметика»
; @desc    (opsarith.ubrk), «сравнения» (opscmp.ubrk), «переходы»
; @desc    (opsjump.ubrk), «система» (opssys.ubrk).

; @method dstack ( -- )
; @in    нет (клетка gc — код; gpc уже переведён декодером за инструкцию)
; @out   нет; CALL обработчика группы «стек» — либо ловушка 2/3 гостя
; @does  Группа «стек» 0x00-0x07 (SPEC/L0-UVM.txt, раздел 5): NOP — nop,
; @does  PUSH — push, DROP — drop, DUP — dup, SWAP — swap, OVER — over,
; @does  ROT — rot, PICK — pick (все — opsstack.ubrk, подшаги 2-3);
; @does  последний код достаётся без сравнения — принадлежность
; @does  диапазону уже проверил decode; кирпич dispatch.
; @depends gc, EQ, DUP, DROP, IF, EXIT, THEN, nop, push, drop, dup, swap,
; @depends over, rot, pick, STOP
: dstack
  gc LOAD64
  DUP 0x00 EQ IF DROP nop EXIT THEN
  DUP 0x01 EQ IF DROP push EXIT THEN
  DUP 0x02 EQ IF DROP drop EXIT THEN
  DUP 0x03 EQ IF DROP dup EXIT THEN
  DUP 0x04 EQ IF DROP swap EXIT THEN
  DUP 0x05 EQ IF DROP over EXIT THEN
  DUP 0x06 EQ IF DROP rot EXIT THEN
  DROP pick ;

; @method dmem ( -- )
; @in    нет (клетка gc — код; gpc уже переведён декодером за инструкцию)
; @out   нет; CALL обработчика группы «память» — либо ловушка 2/7 гостя
; @does  Группа «память» 0x10-0x13 (SPEC/L0-UVM.txt, раздел 5): LOAD8 —
; @does  load8, LOAD64 — load64, STORE8 — store8, STORE64 — store64
; @does  (все — opsmem.ubrk, подшаг 4); последний код достаётся без
; @does  сравнения — принадлежность диапазону уже проверил decode;
; @does  кирпич dispatch.
; @depends gc, EQ, DUP, DROP, IF, EXIT, THEN, load8, load64, store8,
; @depends store64, STOP
: dmem
  gc LOAD64
  DUP 0x10 EQ IF DROP load8 EXIT THEN
  DUP 0x11 EQ IF DROP load64 EXIT THEN
  DUP 0x12 EQ IF DROP store8 EXIT THEN
  DROP store64 ;

; @method darith ( -- )
; @in    нет (клетка gc — код; gpc уже переведён декодером за инструкцию)
; @out   нет; CALL обработчика группы «арифметика» — либо ловушка 1/2
; @does  Группа «арифметика» 0x20-0x2C (SPEC/L0-UVM.txt, раздел 5):
; @does  ADD — add, SUB — sub, MUL — mul, UDIV — udiv, UMOD — umod,
; @does  NEG — neg, SHL — shl, SHR — shr, SAR — sar, AND — and, OR —
; @does  or, XOR — xor, INV — inv (все — opsarith.ubrk, подшаг 5;
; @does  UDIV/UMOD при делителе 0 — ловушка 1); последний код достаётся
; @does  без сравнения — принадлежность диапазону уже проверил decode;
; @does  кирпич dispatch.
; @depends gc, EQ, DUP, DROP, IF, EXIT, THEN, add, sub, mul, udiv, umod,
; @depends neg, shl, shr, sar, and, or, xor, inv, STOP
: darith
  gc LOAD64
  DUP 0x20 EQ IF DROP add EXIT THEN
  DUP 0x21 EQ IF DROP sub EXIT THEN
  DUP 0x22 EQ IF DROP mul EXIT THEN
  DUP 0x23 EQ IF DROP udiv EXIT THEN
  DUP 0x24 EQ IF DROP umod EXIT THEN
  DUP 0x25 EQ IF DROP neg EXIT THEN
  DUP 0x26 EQ IF DROP shl EXIT THEN
  DUP 0x27 EQ IF DROP shr EXIT THEN
  DUP 0x28 EQ IF DROP sar EXIT THEN
  DUP 0x29 EQ IF DROP and EXIT THEN
  DUP 0x2A EQ IF DROP or EXIT THEN
  DUP 0x2B EQ IF DROP xor EXIT THEN
  DROP inv ;

; @method dcmp ( -- )
; @in    нет (клетка gc — код; gpc уже переведён декодером за инструкцию)
; @out   нет; CALL обработчика группы «сравнения» — либо ловушка 2 гостя
; @does  Группа «сравнения» 0x30-0x35 (SPEC/L0-UVM.txt, раздел 5):
; @does  EQ — eq, NEQ — neq, LTU — ltu, GTU — gtu, LEU — leu, GEU —
; @does  geu (все — opscmp.ubrk, подшаг 5); последний код достаётся
; @does  без сравнения — принадлежность диапазону уже проверил decode;
; @does  кирпич dispatch.
; @depends gc, EQ, DUP, DROP, IF, EXIT, THEN, eq, neq, ltu, gtu, leu,
; @depends geu, STOP
: dcmp
  gc LOAD64
  DUP 0x30 EQ IF DROP eq EXIT THEN
  DUP 0x31 EQ IF DROP neq EXIT THEN
  DUP 0x32 EQ IF DROP ltu EXIT THEN
  DUP 0x33 EQ IF DROP gtu EXIT THEN
  DUP 0x34 EQ IF DROP leu EXIT THEN
  DROP geu ;

; @method djump ( -- )
; @in    нет (клетка gc — код; gpc уже переведён декодером за инструкцию)
; @out   нет; CALL обработчика группы «переходы» — либо ловушка 4/5/7
; @does  Группа «переходы» 0x40-0x45 (SPEC/L0-UVM.txt, раздел 5): JMP —
; @does  jmp, JZ — jz, JNZ — jnz, CALL — call, RET — ret, HALT — halt
; @does  (все — opsjump.ubrk, подшаги 2 и 6); последний код достаётся
; @does  без сравнения — принадлежность диапазону уже проверил decode;
; @does  кирпич dispatch.
; @depends gc, EQ, DUP, DROP, IF, EXIT, THEN, jmp, jz, jnz, call, ret,
; @depends halt, STOP
: djump
  gc LOAD64
  DUP 0x40 EQ IF DROP jmp EXIT THEN
  DUP 0x41 EQ IF DROP jz EXIT THEN
  DUP 0x42 EQ IF DROP jnz EXIT THEN
  DUP 0x43 EQ IF DROP call EXIT THEN
  DUP 0x44 EQ IF DROP ret EXIT THEN
  DROP halt ;

; @method dsys ( -- )
; @in    нет (клетка gc — код; gpc уже переведён декодером за инструкцию)
; @out   нет; CALL обработчика SYS-моста — либо ловушка 8 гостя
; @does  Группа «система» 0x50 (SPEC/L0-UVM.txt, раздел 6): SYS — sys
; @does  (opssys.ubrk, подшаг 6: SYS 0/1/2, прочий номер — ловушка 8);
; @does  в группе один код — сравнения нет, принадлежность диапазону
; @does  уже проверил decode; кирпич dispatch.
; @depends sys
: dsys
  sys ;

; @method dispatch ( -- )
; @in    нет (клетка gc — код инструкции; decode уже перевёл gpc)
; @out   нет; CALL слова группы либо обработчика — дерево диапазонов
; @does  Таблица обработчиков — дерево вложенных IF по шести диапазонам
; @does  (SPEC/L4-SELFHOST.txt, раздел 5Б): 0x00-0x07 — dstack,
; @does  0x10-0x13 — dmem, 0x20-0x2C — darith, 0x30-0x35 — dcmp,
; @does  0x40-0x45 — djump, 0x50 — dsys; decode уже проверил
; @does  принадлежность кода (ловушка 6 в декодере), поэтому последний
; @does  диапазон достаётся без сравнения; кирпич цикла main (emu.ubrk).
; @depends gc, LEU, DUP, DROP, dstack, dmem, darith, dcmp, djump, dsys
: dispatch
  gc LOAD64
  DUP 0x07 LEU IF DROP dstack EXIT THEN
  DUP 0x13 LEU IF DROP dmem EXIT THEN
  DUP 0x2C LEU IF DROP darith EXIT THEN
  DUP 0x35 LEU IF DROP dcmp EXIT THEN
  DUP 0x45 LEU IF DROP djump EXIT THEN
  DROP dsys ;
